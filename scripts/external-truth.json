{
  "$comment": "Every suite case must name the external engine that judges it. Self-comparison alone is not capability evidence. `direction` is `both`, `write-to-external` or `external-to-read`. A capability must be covered in both directions across its cases unless `externalOnly` explains why.",
  "sources": ["python-sqlite3", "better-sqlite3", "integrity-check"],
  "directions": ["both", "write-to-external", "external-to-read"],
  "capabilities": {
    "page-header": {},
    "leaf-split": {},
    "overflow": {},
    "serial-types": {},
    "real-affinity": {},
    "rowid-alias": {},
    "sqlite-master": {},
    "mutation": {},
    "index-btree": {},
    "wal": {
      "externalOnly": "The writer never emits WAL frames or a -wal sidecar, so only external-written WAL can be read back."
    },
    "journal": {
      "externalOnly": "The writer never leaves a hot rollback journal, so only external-crashed journals can be replayed."
    },
    "text-encoding": {
      "externalOnly": "The writer always emits UTF-8 databases, so a UTF-16 database can only be produced by an external engine."
    },
    "schema-objects": {
      "externalOnly": "Views, virtual tables and STRICT tables are produced by an external engine. This reader inspects and rejects them rather than creating them."
    },
    "internal-page": {},
    "without-rowid": {
      "externalOnly": "The writer only emits rowid tables, so a WITHOUT ROWID primary-key index can only be produced by an external engine."
    }
  },
