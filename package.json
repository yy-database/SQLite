{
    "name": "sqlite-workspace",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "check": "cargo check --manifest-path projects/sqlite.rs/Cargo.toml --workspace",
        "build:napi": "node scripts/build-napi.mjs",
        "fmt": "cargo fmt --manifest-path projects/sqlite.rs/Cargo.toml --all",
        "test": "node projects/sqlite.ts/packages/sqlite-harness/bin/cli.mjs test",
        "test:rust": "cargo test --manifest-path projects/sqlite.rs/Cargo.toml --workspace",
        "test:py": "python -m unittest discover -s projects/sqlite.py/tests -t projects/sqlite.py/tests",
        "examples:ts": "node --experimental-strip-types projects/sqlite.ts/examples/roundtrip.ts",
        "examples:py": "python projects/sqlite.py/examples/roundtrip.py",
        "test:gate": "node scripts/check-test-floor.mjs"
    },
    "packageManager": "pnpm@10.18.3",
    "engines": {
        "node": ">=24.12.0"
    },
    "devDependencies": {
        "@doki-land/nifty": "^0.1.10",
        "better-sqlite3": "^12.2.0"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "better-sqlite3"
        ]
    }
}
