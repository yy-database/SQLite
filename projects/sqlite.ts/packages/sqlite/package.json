{
    "name": "@yydb/sqlite",
    "version": "0.1.0",
    "private": true,
    "description": "TypeScript surface over the SQLite format-3 native binding",
    "license": "MPL-2.0",
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "lib"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "prepack": "tsc -p tsconfig.json",
        "typecheck": "tsc --noEmit -p tsconfig.json"
    },
    "optionalDependencies": {
        "@yydb/sqlite-darwin-arm64": "workspace:*",
        "@yydb/sqlite-darwin-x64": "workspace:*",
        "@yydb/sqlite-linux-x64": "workspace:*",
        "@yydb/sqlite-win32-x64": "workspace:*"
    },
    "engines": {
        "node": ">=18"
    }
}
