{
    "name": "@sqlite/sqlite",
    "version": "0.1.0",
    "private": true,
    "description": "TypeScript surface over the SQLite format-3 native binding",
    "license": "MPL-2.0",
    "type": "module",
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "import": "./src/index.ts",
            "default": "./src/index.ts"
        }
    },
    "scripts": {
        "typecheck": "tsc --noEmit -p tsconfig.json"
    },
    "devDependencies": {
        "better-sqlite3": "^12.2.0",
        "sql.js": "^1.15.2"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "better-sqlite3"
        ]
    },
    "engines": {
        "node": ">=18"
    }
}
