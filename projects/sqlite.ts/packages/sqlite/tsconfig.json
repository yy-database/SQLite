{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022"],
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "types": ["node"],
        "strict": true,
        "declaration": true,
        "outDir": "dist",
        "rootDir": "src",
        "skipLibCheck": true,
        "newLine": "lf"
    },
    "include": ["src/**/*.ts"]
}
