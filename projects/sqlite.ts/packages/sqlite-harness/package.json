{
    "name": "@yydb/sqlite-harness",
    "version": "0.2.0",
    "private": true,
    "description": "Self-improvement toolbox for SQLite: test, bench, conformance, fixtures and oracle",
    "license": "MPL-2.0",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./conformance": {
            "types": "./dist/conformance/index.d.ts",
            "import": "./dist/conformance/index.js",
            "default": "./dist/conformance/index.js"
        },
        "./bench": {
            "types": "./dist/bench/index.d.ts",
            "import": "./dist/bench/index.js",
            "default": "./dist/bench/index.js"
        },
        "./fuzz": {
            "types": "./dist/fuzz/index.d.ts",
            "import": "./dist/fuzz/index.js",
            "default": "./dist/fuzz/index.js"
        },
        "./report": {
            "types": "./dist/report/index.d.ts",
            "import": "./dist/report/index.js",
            "default": "./dist/report/index.js"
        },
        "./oracle": {
            "types": "./dist/conformance/oracle.d.ts",
            "import": "./dist/conformance/oracle.js",
            "default": "./dist/conformance/oracle.js"
        }
    },
    "bin": {
        "sqlite-harness": "bin/cli.mjs"
    },
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "prepack": "tsc -p tsconfig.json",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "test": "node bin/cli.mjs test",
        "bench": "node bin/cli.mjs bench",
        "conformance": "node bin/cli.mjs conformance",
        "fixtures": "node bin/cli.mjs fixtures",
        "oracle": "node bin/cli.mjs oracle",
        "corpus": "node bin/cli.mjs corpus",
        "fuzz": "node bin/cli.mjs fuzz"
    },
    "files": [
        "dist",
        "bin",
        "corpus",
        "stages",
        "!stages/python/.venv",
        "!stages/python/wheels",
        "!stages/node/out"
    ],
    "dependencies": {
        "@yydb/sqlite": "workspace:*"
    },
    "devDependencies": {
        "better-sqlite3": "^12.2.0",
        "sql.js": "^1.15.2"
    },
    "optionalDependencies": {
        "@yydb/sqlite-darwin-arm64": "workspace:*",
        "@yydb/sqlite-darwin-x64": "workspace:*",
        "@yydb/sqlite-linux-x64": "workspace:*",
        "@yydb/sqlite-win32-x64": "workspace:*"
    }
}
