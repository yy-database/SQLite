{
  "category": "limit-expressions",
  "cases": [
    {
      "id": "limit.arithmetic",
      "setup": [
        "CREATE TABLE t(id INTEGER)",
        "INSERT INTO t VALUES (1), (2), (3), (4), (5)"
      ],
      "sql": "SELECT id FROM t LIMIT 1 + 1",
      "expect": {
        "kind": "rows",
        "rows": [
          [
            1
          ],
          [
            2
          ]
        ]
      }
    },
    {
      "id": "limit.function",
      "setup": [
        "CREATE TABLE t(id INTEGER)",
        "INSERT INTO t VALUES (1), (2), (3), (4), (5)"
      ],
      "sql": "SELECT id FROM t LIMIT abs(-3)",
      "expect": {
        "kind": "rows",
        "rows": [
          [
            1
          ],
          [
            2
          ],
          [
            3
          ]
        ]
      }
    },
    {
      "id": "limit.subquery",
      "setup": [
        "CREATE TABLE t(id INTEGER)",
        "INSERT INTO t VALUES (1), (2), (3), (4), (5)"
      ],
      "sql": "SELECT id FROM t LIMIT (SELECT 2)",
      "expect": {
        "kind": "rows",
        "rows": [
          [
            1
          ],
          [
            2
          ]
        ]
      }
    },
