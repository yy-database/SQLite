    {
      "id": "row_number.partition_order",
      "setup": [
        "CREATE TABLE w(g TEXT, v INTEGER)",
        "INSERT INTO w VALUES ('a', 1), ('a', 2), ('b', 3), ('b', 4)"
      ],
      "sql": "SELECT g, v, row_number() OVER (PARTITION BY g ORDER BY v) FROM w",
      "expect": {
        "kind": "rows",
        "rows": [
          [
            "a",
            1,
            1
          ],
          [
            "a",
            2,
            2
          ],
          [
            "b",
            3,
            1
          ],
          [
            "b",
            4,
            2
          ]
        ]
      }
    },
