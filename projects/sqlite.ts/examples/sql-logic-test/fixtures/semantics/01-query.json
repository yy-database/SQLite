{
  "category": "query-semantics",
  "cases": [
    {
      "id": "where.comparison.eq",
      "setup": [
        "CREATE TABLE t1(a INTEGER, b INTEGER, x TEXT)",
        "INSERT INTO t1 VALUES (1, 2, 'x'), (2, NULL, 'y'), (3, 3, 'z')"
      ],
      "sql": "SELECT a FROM t1 WHERE b = 3",
      "expect": {
        "kind": "rows",
        "rows": [
          [
            3
          ]
        ]
      }
    },
    {
      "id": "where.comparison.ne",
      "setup": [
        "CREATE TABLE t1(a INTEGER, b INTEGER, x TEXT)",
