{
    "name": "@yydb/sqlite-emulator",
    "version": "0.1.0",
    "description": "Read-only `sqlite3`-style command surface over the SQLite format-3 binding",
    "license": "MPL-2.0",
    "private": true,
    "type": "module",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "import": "./src/index.ts",
            "default": "./src/index.ts"
        }
    },
    "bin": {
        "sqlite": "bin/sqlite3.mjs"
    },
    "dependencies": {
        "@yydb/sqlite": "workspace:*"
    }
}
